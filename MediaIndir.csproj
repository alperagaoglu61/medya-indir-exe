<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MediaIndir</RootNamespace>
    <AssemblyName>MediaIndir</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Tek dosya, kendi kendine yeten (calistirmak icin .NET kurulu olmasi gerekmez) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bu iki dosyayi Tools klasorune kendin koyacaksin (asagidaki talimata bak) -->
    <EmbeddedResource Include="Tools\yt-dlp.exe" LogicalName="yt-dlp.exe" />
    <EmbeddedResource Include="Tools\ffmpeg.exe" LogicalName="ffmpeg.exe" />
  </ItemGroup>

</Project>
