<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MediaIndir</RootNamespace>
    <AssemblyName>MediaIndir</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Tek dosya, kendi kendine yeten (calistirmak icin .NET kurulu olmasi gerekmez) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gomulu araclar Core icinde durur, buraya kopyalanmaz. -->
    <ProjectReference Include="..\MediaIndir.Core\MediaIndir.Core.csproj" />
  </ItemGroup>

</Project>
